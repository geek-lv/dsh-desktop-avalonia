<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshDesktop</AssemblyName>
    <RootNamespace>DshDesktop</RootNamespace>
    <Product>DSH Desktop</Product>
    <!-- Local-build default only; CI takes the version from git tags (.github/scripts/version.sh). -->
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- `dotnet publish -r <rid>`: Native AOT, fully trimmed, one native executable
       (plus the few native libraries Avalonia loads: Skia, HarfBuzz, ANGLE on Windows). -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <TrimMode>full</TrimMode>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Ship only what runs: no native symbol files. (ANGLE, av_libglesv2.dll, stays: it is Avalonia's
       Direct3D GPU path on Windows.) -->
  <Target Name="PruneNativePublishFiles" AfterTargets="Publish">
    <ItemGroup>
      <_Prune Include="$(PublishDir)*.pdb;$(PublishDir)*.dbg;$(PublishDir)*.dSYM/**" />
    </ItemGroup>
    <Delete Files="@(_Prune)" />
    <RemoveDir Directories="$([System.IO.Directory]::GetDirectories('$(PublishDir)', '*.dSYM'))" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets/app.ico" />
    <AvaloniaResource Include="Assets/tray.png" />
    <AvaloniaResource Include="Assets/tray-template.png" />
    <EmbeddedResource Include="Assets/splash.html" LogicalName="splash.html" />
    <EmbeddedResource Include="Assets/splash-whale-idle.webp" LogicalName="splash-whale-idle.webp" />
    <EmbeddedResource Include="Assets/splash-whale-sorry.webp" LogicalName="splash-whale-sorry.webp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.2" />
  </ItemGroup>

</Project>
